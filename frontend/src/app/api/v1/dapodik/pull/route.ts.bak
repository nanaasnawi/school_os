import { NextResponse } from 'next/server';

export async function POST(req: Request) {
  try {
    const body = await req.json().catch(() => ({}));
    const dapodikUrl = body.dapodik_url || 'http://localhost:5774';
    const npsn = body.npsn || 'P2962010';
    const bearerToken = body.bearer_token || '';

    const headers: Record<string, string> = {};
    if (bearerToken) {
      headers['Authorization'] = `Bearer ${bearerToken}`;
    }

    let rawStudents: any[] = [];
    let rawGtk: any[] = [];

    // Attempt Server-to-Server Fetch for Peserta Didik & GTK (Bypasses Browser CORS!)
    try {
      const studentUrl = `${dapodikUrl.replace(/\/$/, '')}/WebService/getPesertaDidik?npsn=${npsn}`;
      const gtkUrl = `${dapodikUrl.replace(/\/$/, '')}/WebService/getGtk?npsn=${npsn}`;

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 4000);

      const [resStudent, resGtk] = await Promise.all([
        fetch(studentUrl, { method: 'GET', headers, signal: controller.signal }).catch(() => null),
        fetch(gtkUrl, { method: 'GET', headers, signal: controller.signal }).catch(() => null),
      ]);
      clearTimeout(timeoutId);

      if (resStudent && resStudent.ok) {
        const text = await resStudent.text();
        try {
          const parsed = JSON.parse(text);
          if (Array.isArray(parsed)) rawStudents = parsed;
          else if (parsed && Array.isArray(parsed.rows)) rawStudents = parsed.rows;
        } catch (e) {
          // ignore
        }
      }

      if (resGtk && resGtk.ok) {
        const textGtk = await resGtk.text();
        try {
          const parsedGtk = JSON.parse(textGtk);
          if (Array.isArray(parsedGtk)) rawGtk = parsedGtk;
          else if (parsedGtk && Array.isArray(parsedGtk.rows)) rawGtk = parsedGtk.rows;
        } catch (e) {
          // ignore
        }
      }
    } catch (err) {
      console.warn('[ServerRoute Pull] Direct WebService fetch failed:', err);
    }

    // Map Real Students (NO SAMPLE FALLBACK!)
    const mappedStudents = rawStudents.map((std: any, idx: number) => ({
      id: std.peserta_didik_id || `dapodik-std-${idx}`,
      nisn: std.nisn || `008${100000 + idx}`,
      nik: std.nik || `3201${10000000 + idx}`,
      nama_school_os: (std.nama || std.nama_pd || `SISWA ${idx + 1}`).toUpperCase(),
      nama_dapodik: std.nama || std.nama_pd || `SISWA ${idx + 1}`,
      rombel: std.nama_rombel || std.rombel || 'UMUM',
      identity_state: 'ACTIVE',
      mobility_case: 'NONE',
      classification: 'MATCH',
      action_recommended: 'Pulled Real-Time from Dapodik Localhost WebService',
      stage: 'VERIFIED',
      last_synced_at: new Date().toISOString(),
    }));

    // Map Real GTK (Teachers) (NO SAMPLE FALLBACK!)
    const mappedTeachers = rawGtk.map((gtk: any, idx: number) => {
      const nip = gtk.nip || gtk.nuptk || gtk.nik || `PTK-${idx + 1}`;
      const nama = (gtk.nama || gtk.nama_ptk || gtk.nama_gtk || '').toUpperCase();
      return {
        id: gtk.ptk_id || `gtk-${idx}`,
        nip,
        full_name: nama,
        subject: gtk.jenis_ptk_id_str || 'Guru Kelas',
        phone: '-',
        is_active: true,
      };
    }).filter(t => t.full_name.length > 0);

    return NextResponse.json({
      success: true,
      data: mappedStudents,
      teachers: mappedTeachers,
    });
  } catch (error: any) {
    return NextResponse.json(
      { success: false, error: { message: error.message || 'Error pulling data' } },
      { status: 500 }
    );
  }
}
