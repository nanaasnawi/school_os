{
  "info": {
    "_postman_id": "school-os-api-v1",
    "name": "School OS — Core API Collection",
    "description": "Production-ready Postman Collection for School OS REST API. Includes automatic JWT Bearer token capture, multi-tenant headers, and sample payloads for all core bounded contexts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" },
    { "key": "tenant_id", "value": "tenant-school-001", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Username & Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.data.access_token);",
                  "    pm.environment.set('jwt_token', jsonData.data.access_token);",
                  "    console.log('JWT Token captured successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@school.id\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Student QR Code Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.data.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr_token\": \"qr_sec_tok_example_student_01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/qr-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "qr-login"]
            }
          }
        },
        {
          "name": "List Users (Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "x-tenant-id", "value": "{{tenant_id}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "users"]
            }
          }
        }
      ]
    },
    {
      "name": "2. School & Tenant Management",
      "item": [
        {
          "name": "Get Current School Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "x-tenant-id", "value": "{{tenant_id}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "schools", "profile"]
            }
          }
        },
        {
          "name": "Update Current School Profile",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SMA Negeri 1 Indonesia Unggul\",\n  \"address\": \"Jl. Pendidikan No. 45\",\n  \"phone\": \"021-5551234\",\n  \"email\": \"info@sman1unggul.sch.id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "schools", "profile"]
            }
          }
        },
        {
          "name": "Provision New Tenant (Master Admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"npsn\": \"20104050\",\n  \"name\": \"SMK Bintang Bangsa\",\n  \"slug\": \"smk-bintang-bangsa\",\n  \"admin_name\": \"Kepala Sekolah\",\n  \"admin_email\": \"admin@smkbintang.sch.id\",\n  \"admin_password\": \"AdminSecret123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/system/tenants/provision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "system", "tenants", "provision"]
            }
          }
        }
      ]
    },
    {
