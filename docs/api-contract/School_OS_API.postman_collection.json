            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pengantar Pemrograman Rust & Clean Architecture\",\n  \"description\": \"Informatika • Pemrograman Berorientasi Sistem dan Memori Aman\",\n  \"material_type\": \"article\",\n  \"content_body\": \"Materi lengkap pengantar memory safety dan concurrency di Rust.\",\n  \"class_id\": null\n}"
